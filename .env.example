# Application
NODE_ENV=development
APP_URL=http://localhost:3000
TZ=Asia/Kolkata

# Database
DATABASE_URL=postgresql://rajfashion:rajfashion_dev@localhost:5432/new_raj_fashion?schema=public

# Auth / sessions
AUTH_SECRET=replace-with-a-long-random-secret
SESSION_COOKIE_NAME=nrf_session
SESSION_TTL_DAYS=14

# Owner bootstrap (run: npm run bootstrap:owner). Never ship a default production owner password.
OWNER_BOOTSTRAP_TOKEN=
OWNER_BOOTSTRAP_TOKEN_CONFIRM=
OWNER_BOOTSTRAP_CONFIRM=
OWNER_BOOTSTRAP_USERNAME=
OWNER_BOOTSTRAP_PASSWORD=

# Development-only OTP bypass. MUST remain unset/false in production.
AUTH_DEV_OTP_ENABLED=false
AUTH_DEV_OTP_CODE=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email provider (SMTP). Leave blank until configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# SMS / phone OTP provider (optional). Leave blank until configured.
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SMS_API_KEY=
SMS_SENDER_ID=

# Online checkout remains disabled until valid Razorpay credentials are configured.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MODE=sandbox

# Object storage (S3-compatible). Leave credentials blank until configured.
S3_ENDPOINT=http://localhost:19000
S3_REGION=ap-south-1
S3_BUCKET=new-raj-fashion
# Keep customer reference images in a separate, private bucket without public-read policy.
S3_PRIVATE_BUCKET=new-raj-fashion-private
# Match docker-compose.yml for local development only; replace outside local development.
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:19000/new-raj-fashion

# Rate limiting
RATE_LIMIT_REDIS_URL=

# Configure a trusted scheduler to POST /api/cron/reminders with
# Authorization: Bearer <CRON_SECRET>. Use a unique random value outside local development.
CRON_SECRET=




