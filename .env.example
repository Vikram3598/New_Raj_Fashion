# Application
NODE_ENV=development
APP_URL=http://localhost:3000
TZ=Asia/Kolkata

# Database
DATABASE_URL=postgresql://rajfashion:rajfashion_dev@localhost:5432/new_raj_fashion?schema=public

# Auth / sessions
AUTH_SECRET=replace-with-a-long-random-secret
SESSION_COOKIE_NAME=nrf_session
SESSION_TTL_DAYS=14

# Owner bootstrap (run: npm run bootstrap:owner). Never ship a default production owner password.
OWNER_BOOTSTRAP_TOKEN=
OWNER_BOOTSTRAP_USERNAME=
OWNER_BOOTSTRAP_PASSWORD=

# Development-only OTP bypass. MUST remain unset/false in production.
AUTH_DEV_OTP_ENABLED=false
AUTH_DEV_OTP_CODE=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email provider (SMTP). Leave blank until configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# SMS / phone OTP provider (optional). Leave blank until configured.
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=

# Razorpay (sandbox until production keys are configured)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MODE=sandbox

# Object storage (S3-compatible). MinIO defaults shown for local development.
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=new-raj-fashion
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=

# Rate limiting
RATE_LIMIT_REDIS_URL=
